generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider
  role          UserRole  @default(LANDLORD)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  properties    Property[]
  teamMembers   TeamMember[]
  notifications Notification[]
  activities    ActivityLog[]
  messagesSent  Message[] @relation("SentMessages")
  messagesReceived Message[] @relation("ReceivedMessages")
  maintenanceComments MaintenanceComment[]

  // Stripe
  stripeCustomerId String?
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionTier   SubscriptionTier   @default(FREE)
  subscriptionEndsAt DateTime?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  deletedAt           DateTime?
  deletedBy           String?
  isDeleted           Boolean  @default(false)

  @@index([email])
  @@index([stripeCustomerId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== TEAM & ROLES ====================

enum UserRole {
  LANDLORD
  TENANT
  MANAGER
  VIEWER
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INACTIVE
  TRIALING
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  propertyId String?
  role      TeamRole @default(MANAGER)
  permissions Json?   // Flexible permission object
  invitedBy String
  status    TeamMemberStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
}

enum TeamRole {
  OWNER
  MANAGER
  VIEWER
}

enum TeamMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

// ==================== PROPERTIES & UNITS ====================

model Property {
  id          String   @id @default(cuid())
  landlordId  String
  name        String
  description String?  @db.Text
  address     String
  city        String
  state       String
  zipCode     String
  country     String   @default("US")
  type        PropertyType @default(RESIDENTIAL)
  status      PropertyStatus @default(ACTIVE)
  bedrooms    Int?
  bathrooms   Float?
  squareFeet  Int?
  yearBuilt   Int?
  amenities   String[] // Array of amenity strings
  photos      String[] // Array of photo URLs
  taxId       String?
  insurancePolicy String?
  insuranceExpiry DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  landlord    User       @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  units       Unit[]
  teamMembers TeamMember[]
  expenses    Expense[]
  documents   Document[]
  activities  ActivityLog[]
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean?  @default(false)
  messages    Message[]

  @@index([landlordId])
  @@index([status])
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MULTIFAMILY
  TOWNHOUSE
  CONDO
  SINGLE_FAMILY
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  UNDER_CONSTRUCTION
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  unitNumber  String
  floor       String?
  status      UnitStatus @default(VACANT)
  rentAmount  Decimal    @db.Decimal(10, 2)
  depositAmount Decimal @db.Decimal(10, 2) @default(0)
  squareFeet  Int?
  bedrooms    Int?
  bathrooms   Float?
  description String?    @db.Text
  amenities   String[]
  photos      String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenanceRequests MaintenanceRequest[]
  expenses    Expense[]
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean?  @default(false)

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@index([status])
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  OFF_MARKET
}

// ==================== TENANTS & LEASES ====================

model Tenant {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  dateOfBirth     DateTime?
  ssnLastFour     String?  // Encrypted in application layer
  emergencyName   String?
  emergencyPhone  String?
  emergencyRelation String?
  creditScore     Int?
  backgroundCheckUrl String?
  employmentInfo  Json?    // { employer, position, income, startDate }
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  leases          Lease[]
  payments        Payment[]
  maintenanceRequests MaintenanceRequest[]
  messages        Message[]
  documents       Document[]
  activities      ActivityLog[]
  deletedAt       DateTime?
  deletedBy       String?
  isDeleted       Boolean  @default(false)

  @@index([email])
}

model Lease {
  id              String      @id @default(cuid())
  tenantId        String
  unitId          String
  propertyId      String
  startDate       DateTime
  endDate         DateTime
  rentAmount      Decimal     @db.Decimal(10, 2)
  depositAmount   Decimal     @db.Decimal(10, 2) @default(0)
  lateFeeAmount   Decimal     @db.Decimal(10, 2) @default(50)
  lateFeeAfterDays Int        @default(5)
  gracePeriodDays Int         @default(3)
  status          LeaseStatus @default(ACTIVE)
  autoRenew       Boolean     @default(false)
  renewalTerms    String?     @db.Text
  documentUrl     String?     // Signed lease PDF
  signatureUrl    String?     // Signature image
  signedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  payments Payment[]
  rentCharges RentCharge[]
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([endDate])
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING_SIGNATURE
  DRAFT
}

model RentCharge {
  id          String    @id @default(cuid())
  leaseId     String
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  description String?   @default("Monthly Rent")
  status      ChargeStatus @default(PENDING)
  paidAmount  Decimal   @db.Decimal(10, 2) @default(0)
  lateFeeApplied Boolean @default(false)
  lateFeeAmount Decimal  @db.Decimal(10, 2) @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lease       Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([leaseId])
  @@index([dueDate])
  @@index([status])
}

enum ChargeStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
}

// ==================== PAYMENTS ====================

model Payment {
  id            String        @id @default(cuid())
  landlordId    String
  tenantId      String
  leaseId       String?
  rentChargeId  String?
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  type          PaymentType   @default(RENT)
  method        PaymentMethod @default(CARD)
  stripePaymentIntentId String?
  stripeChargeId String?
  receiptUrl    String?
  receiptNumber String?       @default(uuid())
  description   String?
  metadata      Json?
  processedAt   DateTime?
  refundedAt    DateTime?
  refundAmount  Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease      Lease?      @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  rentCharge RentCharge? @relation(fields: [rentChargeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([leaseId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([createdAt])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentType {
  RENT
  DEPOSIT
  LATE_FEE
  UTILITY
  MAINTENANCE
  OTHER
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  CHECK
  MONEY_ORDER
  ACH
}

// ==================== MAINTENANCE ====================

model MaintenanceRequest {
  id          String    @id @default(cuid())
  tenantId    String?
  unitId      String
  propertyId  String
  title       String
  description String    @db.Text
  category    MaintenanceCategory @default(GENERAL)
  priority    Priority  @default(MEDIUM)
  status      MaintenanceStatus @default(SUBMITTED)
  photos      String[]
  estimatedCost Decimal? @db.Decimal(10, 2)
  actualCost    Decimal? @db.Decimal(10, 2)
  completedAt   DateTime?
  scheduledDate DateTime?
  vendorId    String?
  assignedTo  String?   // User ID of assignee
  resolution  String?   @db.Text
  tenantFeedback String? @db.Text
  tenantRating Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor   Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  comments MaintenanceComment[]
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)

  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  PEST_CONTROL
  LANDSCAPING
  SECURITY
  GENERAL
  EMERGENCY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
  REOPENED
}

model MaintenanceComment {
  id        String   @id @default(cuid())
  requestId String
  userId    String?
  tenantId  String?
  message   String   @db.Text
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model Vendor {
  id          String   @id @default(cuid())
  landlordId  String
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  specialties String[]
  licenseNumber String?
  insuranceUrl String?
  rating      Float?   @default(0)
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests MaintenanceRequest[]

  @@index([landlordId])
}

// ==================== ACCOUNTING ====================

model Expense {
  id          String        @id @default(cuid())
  landlordId  String
  propertyId  String?
  unitId      String?
  category    ExpenseCategory @default(OTHER)
  amount      Decimal       @db.Decimal(10, 2)
  description String
  date        DateTime
  receiptUrl  String?
  vendor      String?
  taxDeductible Boolean     @default(true)
  isRecurring Boolean     @default(false)
  recurringFrequency String? // monthly, yearly, etc.
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([landlordId])
  @@index([propertyId])
  @@index([date])
  @@index([category])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
}

enum ExpenseCategory {
  MAINTENANCE
  REPAIRS
  UTILITIES
  INSURANCE
  TAXES
  MORTGAGE
  MANAGEMENT
  ADVERTISING
  LEGAL
  SUPPLIES
  CLEANING
  LANDSCAPING
  HOA
  OTHER
}

// ==================== DOCUMENTS ====================

model Document {
  id          String         @id @default(cuid())
  landlordId  String
  propertyId  String?
  tenantId    String?
  name        String
  type        DocumentType   @default(OTHER)
  url         String
  size        Int?
  mimeType    String?
  tags        String[]
  isEncrypted Boolean        @default(false)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([landlordId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([type])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
}

enum DocumentType {
  LEASE
  APPLICATION
  ID_DOCUMENT
  INSURANCE
  INSPECTION
  RECEIPT
  CONTRACT
  EVICTION_NOTICE
  COMPLIANCE
  PHOTO
  OTHER
}

// ==================== MESSAGING ====================

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  propertyId  String?
  tenantId    String?
  subject     String?
  body        String   @db.Text
  isBulk      Boolean  @default(false)
  sentVia     MessageChannel @default(IN_APP)
  templateId  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([recipientId])
  @@index([tenantId])
  @@index([createdAt])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
}

enum MessageChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ==================== NOTIFICATIONS & ACTIVITY ====================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?            // Contextual data
  read      Boolean          @default(false)
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
}

enum NotificationType {
  RENT_DUE
  RENT_PAID
  RENT_OVERDUE
  LEASE_EXPIRING
  MAINTENANCE_UPDATE
  NEW_MESSAGE
  PAYMENT_FAILED
  TEAM_INVITE
  SYSTEM
}

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String?
  tenantId   String?
  propertyId String?
  action     String       // e.g., "LEASE_CREATED", "PAYMENT_RECEIVED"
  entityType String?      // "Lease", "Payment", etc.
  entityId   String?
  details    Json?        // Before/after snapshots
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean  @default(false)
  @@index([action])
}

// ==================== COMPLIANCE ====================

model ComplianceChecklist {
  id          String   @id @default(cuid())
  propertyId  String
  country     String   @default("US")
  state       String?
  items       Json     // Array of { id, label, required, completed, completedAt, evidenceUrl }
  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ==================== SETTINGS & TEMPLATES ====================

model EmailTemplate {
  id        String   @id @default(cuid())
  landlordId String
  name      String
  subject   String
  body      String   @db.Text
  variables String[] // e.g., ["tenantName", "dueDate", "amount"]
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId])
}

model LandlordSettings {
  id                String   @id @default(cuid())
  landlordId        String   @unique
  defaultLateFee    Decimal  @db.Decimal(10, 2) @default(50)
  defaultGracePeriod Int     @default(3)
  autoChargeEnabled Boolean  @default(false)
  reminderDays      Int[]    @default([3, 1]) // Days before due date
  currency          String   @default("USD")
  timezone          String   @default("America/New_York")
  dateFormat        String   @default("MM/DD/YYYY")
  emailSignature    String?  @db.Text
  brandingColor     String?  @default("#000000")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
